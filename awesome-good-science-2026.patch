-    _HEADING_RE = re.compile(r"^(#{2,3})\s+(.+)$")
-
-    def __init__(self, readme_path: Path) -> None:
-        self.path = readme_path
-        self.raw_text: str = ""
-        self.lines: list[str] = []
-        self.sections: list[SectionInfo] = []
